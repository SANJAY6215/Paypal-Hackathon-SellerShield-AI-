# Copy to backend/.env  (never commit real values)
DATABASE_URL="file:./dev.db"            # SQLite default. For PostgreSQL see README (postgresql://sellershield:sellershield@localhost:5432/sellershield)

# Discovery Lab LLM attacker: providers are tried in this order and the next one is used if a key is rejected / rate-limited / down.
# Free keys: Gemini (aistudio.google.com) and Groq (console.groq.com). Model names are configurable; defaults are NOT verified live.
GEMINI_ENABLED=false                    # Gemini is skipped unless set to true (needs billing on its Google project)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_PROVIDER_ORDER=gemini,groq

# Without any key, agents use the deterministic planner and the UI says so. Anthropic is no longer used.

# PayPal Sandbox (optional: without credentials the app runs a labelled local simulation)
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_BASE_URL=https://api-m.sandbox.paypal.com
PAYPAL_WEBHOOK_ID=                      # needed for real webhook verification (see docs/WEBHOOK_SETUP.md)

JWT_SECRET=change-me-to-a-long-random-string
APP_URL=http://localhost:3000
API_URL=http://localhost:4000
PORT=4000
REDIS_URL=                              # unused: jobs are DB-backed, in-process
DEMO_MODE=true
AGENT_STEP_DELAY_MS=450                 # pacing of live runs so progress is observable

# Defence-as-Pull-Request (optional; untested against real GitHub). Token needs contents:write + pull_requests:write on the repo.
GITHUB_TOKEN=
GITHUB_REPO=                            # owner/name
GITHUB_BASE_BRANCH=main
GITHUB_API_URL=https://api.github.com

# Local PayPal emulator used by the red team (mounted at /mock-paypal). Disabled in production unless set to true.
ENABLE_PAYPAL_EMULATOR=
SELF_URL=                               # only if the API is not reachable at http://127.0.0.1:PORT from itself
